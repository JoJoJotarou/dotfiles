# =============================================================================
# Ghostty 配置文件
# 位置: ~/.config/ghostty/config
# 生效: 保存即热重载（仅部分选项需重启）
# 验证: ghostty +validate-config
# 查看: ghostty +show-config
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 字体
# ─────────────────────────────────────────────────────────────────────────────

# Starship/p10k 等工具需要 Nerd Font 显示图标
font-family = "JetBrainsMono Nerd Font"
# 回退字体（当前字体缺失字形时自动 fallback，如 emoji）
font-family = "Apple Color Emoji"

font-size = 14

# 字重选项: thin, extralight, light, demilight, regular, medium,
#           demibold, bold, extrabold, black
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic

# 启用连字 (>=, ->, !== 等渲染成单个符号)
font-feature = +calt
font-feature = +liga

# 字体加粗，Retina 屏上更清晰
font-thicken=true
# 加粗程度
font-thicken-strength=1
# ─────────────────────────────────────────────────────────────────────────────
# 配色主题
# ─────────────────────────────────────────────────────────────────────────────

# 使用内置主题，完整列表: ghostty +list-themes
# 支持 light/dark 自动切换（跟随 macOS 外观设置）
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# ─────────────────────────────────────────────────────────────────────────────
# 窗口
# ─────────────────────────────────────────────────────────────────────────────

# 内边距（像素），避免文字紧贴窗口边缘
window-padding-x = 8
window-padding-y = 6

# 背景透明度 (0.0 ~ 1.0)
background-opacity = 0.95

# 模糊半径（配合透明度，让背景内容模糊显示）
# background-blur-radius = 20

# 窗口主题: light, dark, auto（跟随系统）
window-theme = dark

# 保存窗口状态（split/tab 布局、工作目录等）
# 可选: never, always, restore（仅恢复，不保存）
window-save-state = always

# 新窗口继承当前工作目录
window-inherit-working-directory = true

# 隐藏标题栏，最大化屏幕空间
# macos-titlebar-style = hidden

# ─────────────────────────────────────────────────────────────────────────────
# 光标
# ─────────────────────────────────────────────────────────────────────────────

# 样式: block, bar, underline
cursor-style = bar
cursor-style-blink = true
# ─────────────────────────────────────────────────────────────────────────────
# 滚动
# ─────────────────────────────────────────────────────────────────────────────


# 回滚缓冲区行数
# scrollback-limit = 10000

# ─────────────────────────────────────────────────────────────────────────────
# 鼠标
# ─────────────────────────────────────────────────────────────────────────────

# 打字时隐藏鼠标指针
mouse-hide-while-typing = true

# 选中即复制到剪贴板（clipboard / selection / none）
copy-on-select = clipboard

# ─────────────────────────────────────────────────────────────────────────────
# 剪贴板 (OSC 52)
# ─────────────────────────────────────────────────────────────────────────────

# 允许程序通过 OSC 52 读取/写入系统剪贴板（Claude Code/Codex 粘贴图片需要）
clipboard-read = allow
clipboard-write = allow

# Shell 集成
# ─────────────────────────────────────────────────────────────────────────────

# 自动检测并启用 shell 集成（跳转提示 / 命令状态 / 点击路径等）
# 可选: detect, zsh, bash, fish, elvish, none
shell-integration = detect

# ─────────────────────────────────────────────────────────────────────────────
# 快捷键
# ─────────────────────────────────────────────────────────────────────────────

# 全局下拉终端（Quake 风格），按快捷键从屏幕顶部拉出终端
# 注意: global: 前缀使快捷键在 Ghostty 未聚焦时也能生效
# 需要系统权限: 系统设置 -> 隐私与安全性 -> 辅助功能 -> 允许 Ghostty
keybind = global:ctrl+shift+space=toggle_quick_terminal
