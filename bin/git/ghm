#!/bin/bash
#
# ghm - GitHub 多账号 + 多组织 本地管理工具
#
# 功能：
# - 管理多个 GitHub 账号（每个账号一个 SSH 密钥）
# - 支持单账号下的多个组织仓库目录
# - 提供 ghm add / delete / list / git 等命令
# - ghm git 是 git 的智能包装器，会根据当前目录自动选择对应账号的 SSH 密钥
# - UserID 保留用户输入的原始大小写，查找时不区分大小写
#
# 目录结构：
#   $GITHUB_BASE_DIR/<UserID>/
#       personal/          # 该账号的个人仓库
#       <OrgID>/           # 该账号下的组织仓库
#
# 使用方法：
#   1. chmod +x ghm
#   2. 把 dotfiles/bin 加入 PATH
#   3. ghm help
#

set -euo pipefail

# ==================== 配置 ====================
GHM_SSH_CONFIG_MARKER="# ghm-managed"

GITHUB_BASE_DIR="${GITHUB_BASE_DIR:-$HOME/Developer/github}"
SSH_DIR="${SSH_DIR:-$HOME/.ssh}"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info()  { printf '%b\n' "${BLUE}[INFO]${NC} $1"; }
log_ok()    { printf '%b\n' "${GREEN}[OK]${NC}   $1"; }
log_warn()  { printf '%b\n' "${YELLOW}[WARN]${NC} $1"; }
log_error() { printf '%b\n' "${RED}[ERROR]${NC} $1" >&2; }

# ==================== 工具函数 ====================

ensure_dirs() {
    mkdir -p "$GITHUB_BASE_DIR"
    mkdir -p "$SSH_DIR"
}

backup_file() {
    local file="$1"
    if [[ -f "$file" ]]; then
        cp "$file" "$file.bak.$(date +%Y%m%d-%H%M%S)"
        log_info "已备份: $file"
    fi
}

format_path_for_home() {
    local path="$1"

    if [[ "$path" == "$HOME" ]]; then
        printf '%s\n' "~"
    elif [[ "$path" == "$HOME/"* ]]; then
        printf '~/%s\n' "${path#$HOME/}"
    else
        printf '%s\n' "$path"
    fi
}

gitconfig_include_pattern_for_userid() {
    local userid="$1"
    printf 'gitdir:%s\n' "$(format_path_for_home "$GITHUB_BASE_DIR/$userid/")"
}

ssh_config_identityfile_for_userid() {
    local userid="$1"
    printf '%s\n' "$(format_path_for_home "$SSH_DIR/id_ed25519_$userid")"
}

normalize_userid_for_match() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

find_existing_userid() {
    local lookup_userid="${1:-}"
    local lookup_userid_normalized
    lookup_userid_normalized=$(normalize_userid_for_match "$lookup_userid")

    local keyfile userid
    for keyfile in "$SSH_DIR"/id_ed25519_*; do
        [[ -f "$keyfile" ]] || continue
        userid=$(basename "$keyfile")
        [[ "$userid" == *.pub ]] && continue
        userid="${userid#id_ed25519_}"

        if [[ "$(normalize_userid_for_match "$userid")" == "$lookup_userid_normalized" ]]; then
            printf '%s\n' "$userid"
            return 0
        fi
    done

    return 1
}

find_keyfile_by_userid() {
    local userid="${1:-}"
    local existing_userid

    existing_userid=$(find_existing_userid "$userid") || return 1
    printf '%s\n' "$SSH_DIR/id_ed25519_$existing_userid"
}

list_managed_userids() {
    local keyfile userid
    for keyfile in "$SSH_DIR"/id_ed25519_*; do
        [[ -f "$keyfile" ]] || continue
        userid=$(basename "$keyfile")
        [[ "$userid" == *.pub ]] && continue
        userid="${userid#id_ed25519_}"
        printf '%s\n' "$userid"
    done
}

select_managed_userid() {
    if ! select_userid_with_options "${1:-请选择要使用的 GitHub 账号：}" "false"; then
        log_error "没有找到任何账号，请先运行 ghm add"
        exit 1
    fi
}

# git 包装器：选已有账号，或 0 = 不注入 ghm（等同普通 git）
select_userid_or_plain_git() {
    select_userid_with_options "${1:-未匹配到账号目录，请选择: }" "true"
}

select_userid_with_options() {
    local prompt="$1"
    local allow_plain_git="${2:-false}"
    ensure_dirs

    local accounts=()
    local userid
    while IFS= read -r userid; do
        [[ -n "$userid" ]] || continue
        accounts+=("$userid")
    done < <(list_managed_userids)

    if [[ ${#accounts[@]} -eq 0 ]]; then
        return 1
    fi

    printf '%b\n' "${GREEN}${prompt}${NC}" >&2
    if [[ "$allow_plain_git" == "true" ]]; then
        echo "  0) 系统默认 git（不使用 ghm SSH / 不重写 URL）" >&2
    fi
    local i=1
    local account
    for account in "${accounts[@]}"; do
        echo "  $i) $account" >&2
        ((i++))
    done

    local choice
    read -rp "输入序号: " choice
    if [[ "$allow_plain_git" == "true" && "$choice" == "0" ]]; then
        printf '%s\n' ""
        return 0
    fi
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#accounts[@]} )); then
        log_error "无效选择"
        exit 1
    fi

    printf '%s\n' "${accounts[$((choice-1))]}"
}

# 从当前目录检测 UserID（~/Developer/github/<UserID>/...）
detect_userid_from_pwd() {
    if [[ "$PWD" == "$GITHUB_BASE_DIR"/* ]]; then
        local relative="${PWD#$GITHUB_BASE_DIR/}"
        local userid="${relative%%/*}"

        local existing_userid
        if existing_userid=$(find_existing_userid "$userid"); then
            echo "$existing_userid"
            return 0
        fi
    fi
    echo ""
}

is_github_remote_url() {
    local arg="${1:-}"
    [[ "$arg" =~ ^git@ ]] || [[ "$arg" =~ ^ssh://git@ ]] || [[ "$arg" =~ github\.com ]]
}

# 从远程 URL 解析 owner、repo（repo 不含 .git）
github_owner_repo_from_url() {
    local url="${1:-}"
    local owner="" repo=""

    if [[ "$url" =~ ^git@[^:]+:([^/]+)/(.+)$ ]]; then
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]}"
    elif [[ "$url" =~ ^ssh://git@[^/]+/([^/]+)/(.+)$ ]]; then
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]}"
    elif [[ "$url" =~ ^https?://([^/]*\.)?github\.com/([^/]+)/(.+)$ ]]; then
        owner="${BASH_REMATCH[2]}"
        repo="${BASH_REMATCH[3]}"
    else
        return 1
    fi

    repo="${repo%.git}"
    repo="${repo%%/*}"
    if [[ -z "$owner" || -z "$repo" ]]; then
        return 1
    fi
    printf '%s\n%s\n' "$owner" "$repo"
}

# 从 git 参数里的远程 URL 解析 owner（用户或组织，如 chengzi-io）
extract_github_owner_from_git_args() {
    local arg owner
    for arg in "$@"; do
        if ! is_github_remote_url "$arg"; then
            continue
        fi
        if owner=$(github_owner_repo_from_url "$arg" | head -n1); then
            printf '%s\n' "$owner"
            return 0
        fi
    done
    return 1
}

# ghm 管理的 clone 目标：~/Developer/github/<UserID>/<OrgId>/<repo>（个人仓用 personal）
ghm_clone_destination_for() {
    local userid="$1"
    local owner="$2"
    local repo="$3"

    if [[ "$(normalize_userid_for_match "$userid")" == "$(normalize_userid_for_match "$owner")" ]]; then
        printf '%s\n' "$GITHUB_BASE_DIR/$userid/personal/$repo"
    else
        printf '%s\n' "$GITHUB_BASE_DIR/$userid/$owner/$repo"
    fi
}

# 解析 git clone 参数：输出 clone 选项、远程 URL（供重写与落盘）
parse_git_clone_args() {
    local -a clone_opts=()
    local remote_url=""
    local dest_path=""
    local arg

    if [[ "${1:-}" != "clone" ]]; then
        return 1
    fi
    shift

    for arg in "$@"; do
        if [[ -z "$remote_url" ]] && is_github_remote_url "$arg"; then
            remote_url="$arg"
            continue
        fi

        if [[ -z "$remote_url" ]]; then
            clone_opts+=("$arg")
            continue
        fi

        if [[ -z "$dest_path" ]]; then
            dest_path="$arg"
            continue
        fi

        return 1
    done

    if [[ -z "$remote_url" ]]; then
        return 1
    fi

    if (( ${#clone_opts[@]} > 0 )); then
        printf '%s\0' "${clone_opts[@]}"
    fi
    printf '%s\0' "$remote_url"
    printf '%s\0' "$dest_path"
}

# 根据 GitHub owner 匹配本地目录 ~/Developer/github/<UserID>/<owner>/ 或 personal（owner=账号名）
find_userid_for_github_owner() {
    local owner="${1:-}"
    [[ -n "$owner" ]] || return 1

    local owner_lc
    owner_lc=$(normalize_userid_for_match "$owner")
    local userid existing_userid

    while IFS= read -r userid; do
        [[ -n "$userid" ]] || continue
        if [[ -d "$GITHUB_BASE_DIR/$userid/$owner" ]]; then
            printf '%s\n' "$userid"
            return 0
        fi
        if [[ "$(normalize_userid_for_match "$userid")" == "$owner_lc" ]]; then
            if [[ -d "$GITHUB_BASE_DIR/$userid/personal" ]]; then
                printf '%s\n' "$userid"
                return 0
            fi
        fi
    done < <(list_managed_userids)

    return 1
}

# 仅自动：当前目录 或存在 ~/Developer/github/<账号>/<owner>/
resolve_git_userid_auto() {
    local userid owner

    userid=$(detect_userid_from_pwd)
    if [[ -n "$userid" ]]; then
        printf '%s\n' "$userid"
        return 0
    fi

    if owner=$(extract_github_owner_from_git_args "$@"); then
        if userid=$(find_userid_for_github_owner "$owner"); then
            log_info "ghm: 根据仓库 owner [$owner] 匹配到账号 [$userid]" >&2
            printf '%s\n' "$userid"
            return 0
        fi
    fi

    return 1
}

# 将 git@github.com: 重写为 ghm 的 Host 别名（走 ~/.ssh/config 的 443 + IdentityFile）
rewrite_github_ssh_urls_in_args() {
    local userid="$1"
    shift
    local host_alias="$(printf %s "$userid" | tr "[:upper:]" "[:lower:]").github.com"  # ssh 的 Host 匹配大小写敏感（不会自动转小写），且 gh 靠 ssh config 别名识别 github.com，所以别名写小写并保持 URL/config 一致
    local arg rewritten
    local -a out=()

    for arg in "$@"; do
        rewritten="$arg"
        if [[ "$arg" =~ ^git@github\.com: ]]; then
            rewritten="git@${host_alias}:${arg#git@github.com:}"
        elif [[ "$arg" =~ ^ssh://git@github\.com/ ]]; then
            rewritten="ssh://git@${host_alias}/${arg#ssh://git@github.com/}"
        fi
        out+=("$rewritten")
    done

    printf '%s\0' "${out[@]}"
}

# 检查 SSH config 是否已包含某个 Host
ssh_config_has_host() {
    local host="$1"
    [[ -f "$SSH_DIR/config" ]] || return 1

    awk -v host="$host" '
        BEGIN {
            target = tolower(host)
        }
        tolower($1) == "host" {
            for (i = 2; i <= NF; i++) {
                if (tolower($i) == target) {
                    found = 1
                    exit 0
                }
            }
        }
        END {
            exit(found ? 0 : 1)
        }
    ' "$SSH_DIR/config"
}

# 备份 SSH config
backup_ssh_config() {
    backup_file "$SSH_DIR/config"
}

write_file_preserve_symlink() {
    local target_file="$1"
    local source_file="$2"

    cat "$source_file" > "$target_file"
}

gitconfig_has_include_pattern() {
    local pattern="$1"
    local gitconfig_file="$HOME/.gitconfig"

    [[ -f "$gitconfig_file" ]] || return 1
    grep -Fqi "$pattern" "$gitconfig_file"
}

ssh_config_has_managed_block_for_userid() {
    local userid="$1"
    local config_file="$SSH_DIR/config"

    [[ -f "$config_file" ]] || return 1
    grep -Fqi "$GHM_SSH_CONFIG_MARKER - $userid" "$config_file"
}

gitconfig_has_managed_block_for_userid() {
    local userid="$1"
    local gitconfig_file="$HOME/.gitconfig"

    [[ -f "$gitconfig_file" ]] || return 1
    grep -Fqi "# ghm-managed for $userid" "$gitconfig_file"
}

gitconfig_get_user_field() {
    local userid="$1"
    local field="$2"
    local gitconfig_file="$HOME/.gitconfig"

    [[ -f "$gitconfig_file" ]] || return 1

    awk -v marker="# ghm-managed for $userid" -v field="$field" '
        BEGIN {
            target_marker = tolower(marker)
            target_field = tolower(field)
            in_block = 0
        }
        tolower($0) == target_marker {
            in_block = 1
            next
        }
        in_block && /^# ghm-managed for / {
            exit
        }
        in_block {
            line = $0
            lower = tolower(line)
            pattern = "^[[:space:]]*" target_field "[[:space:]]*="
            if (lower ~ pattern) {
                sub(/^[[:space:]]*[^=]+=[[:space:]]*/, "", line)
                print line
                exit
            }
        }
    ' "$gitconfig_file"
}

gitconfig_get_user_field_by_include_pattern() {
    local include_pattern="$1"
    local field="$2"
    local gitconfig_file="$HOME/.gitconfig"

    [[ -f "$gitconfig_file" ]] || return 1

    awk -v include_pattern="$include_pattern" -v field="$field" '
        BEGIN {
            target_include = "[includeif \"" tolower(include_pattern) "\"]"
            target_field = tolower(field)
            in_block = 0
        }
        tolower($0) == target_include {
            in_block = 1
            next
        }
        in_block && /^\[/ {
            exit
        }
        in_block {
            line = $0
            lower = tolower(line)
            pattern = "^[[:space:]]*" target_field "[[:space:]]*="
            if (lower ~ pattern) {
                sub(/^[[:space:]]*[^=]+=[[:space:]]*/, "", line)
                print line
                exit
            }
        }
    ' "$gitconfig_file"
}

gitconfig_block_matches_userid() {
    local userid="$1"
    local gitconfig_file="$HOME/.gitconfig"
    local include_pattern
    include_pattern=$(gitconfig_include_pattern_for_userid "$userid")

    [[ -f "$gitconfig_file" ]] || return 1

    grep -Fq "# ghm-managed for $userid" "$gitconfig_file" &&
    grep -Fq "[includeIf \"$include_pattern\"]" "$gitconfig_file"
}

gitconfig_remove_include_blocks_by_pattern() {
    local include_pattern="$1"
    local gitconfig_file="$HOME/.gitconfig"

    [[ -f "$gitconfig_file" ]] || return 0

    local tmpfile
    tmpfile=$(mktemp "${TMPDIR:-/tmp}/ghm-gitconfig-include.XXXXXX")

    awk -v include_pattern="$include_pattern" '
        BEGIN {
            skip = 0
        }
        {
            line_lower = tolower($0)
            target = "[includeif \"" tolower(include_pattern) "\"]"

            if (!skip && line_lower == target) {
                skip = 1
                next
            }

            if (skip) {
                if ($0 ~ /^[[:space:]]*$/) {
                    next
                }
                if ($0 ~ /^[[:space:]]+/) {
                    next
                }
                skip = 0
            }

            print
        }
    ' "$gitconfig_file" > "$tmpfile"

    write_file_preserve_symlink "$gitconfig_file" "$tmpfile"
    rm -f "$tmpfile"
}

ssh_config_remove_host_blocks_by_host() {
    local host="$1"
    local config_file="$SSH_DIR/config"

    [[ -f "$config_file" ]] || return 0

    local tmpfile
    tmpfile=$(mktemp "${TMPDIR:-/tmp}/ghm-ssh-host.XXXXXX")

    awk -v host="$host" '
        BEGIN {
            skip = 0
            target = tolower(host)
        }
        {
            first = tolower($1)

            if (!skip && first == "host") {
                matched = 0
                for (i = 2; i <= NF; i++) {
                    if (tolower($i) == target) {
                        matched = 1
                        break
                    }
                }
                if (matched) {
                    skip = 1
                    next
                }
            }

            if (skip) {
                if ($0 ~ /^[[:space:]]*$/) {
                    next
                }
                if (first == "host") {
                    skip = 0
                } else if ($0 ~ /^[[:space:]]+/) {
                    next
                } else {
                    skip = 0
                }
            }

            print
        }
    ' "$config_file" > "$tmpfile"

    write_file_preserve_symlink "$config_file" "$tmpfile"
    rm -f "$tmpfile"
}

replace_in_file() {
    local file="$1"
    local old_value="$2"
    local new_value="$3"

    [[ -f "$file" ]] || return 0
    [[ "$old_value" != "$new_value" ]] || return 0

    local tmpfile
    tmpfile=$(mktemp "${TMPDIR:-/tmp}/ghm-replace.XXXXXX")

    awk -v old_value="$old_value" -v new_value="$new_value" '
        {
            line = $0
            gsub(old_value, new_value, line)
            print line
        }
    ' "$file" > "$tmpfile"

    write_file_preserve_symlink "$file" "$tmpfile"
    rm -f "$tmpfile"
}

rename_path_case_safe() {
    local old_path="$1"
    local new_path="$2"

    [[ -e "$old_path" ]] || return 0
    [[ "$old_path" != "$new_path" ]] || return 0

    local old_basename new_basename parent_dir temp_path
    parent_dir=$(dirname "$old_path")
    old_basename=$(basename "$old_path")
    new_basename=$(basename "$new_path")

    if [[ "$parent_dir" == "$(dirname "$new_path")" ]] && [[ "$(normalize_userid_for_match "$old_basename")" == "$(normalize_userid_for_match "$new_basename")" ]]; then
        temp_path="$parent_dir/.ghm-rename-${old_basename}.$$"
        mv "$old_path" "$temp_path"
        mv "$temp_path" "$new_path"
    else
        mv "$old_path" "$new_path"
    fi
}

rename_account_case() {
    local old_userid="$1"
    local new_userid="$2"

    [[ "$old_userid" != "$new_userid" ]] || return 0

    local old_keyfile="$SSH_DIR/id_ed25519_$old_userid"
    local new_keyfile="$SSH_DIR/id_ed25519_$new_userid"
    local old_pubfile="${old_keyfile}.pub"
    local new_pubfile="${new_keyfile}.pub"
    local old_dir="$GITHUB_BASE_DIR/$old_userid"
    local new_dir="$GITHUB_BASE_DIR/$new_userid"
    local ssh_config_file="$SSH_DIR/config"
    local gitconfig_file="$HOME/.gitconfig"

    if [[ -e "$new_keyfile" && ! -e "$old_keyfile" ]]; then
        log_error "目标账号大小写 [$new_userid] 已存在私钥文件，无法迁移"
        exit 1
    fi
    if [[ -e "$new_pubfile" && ! -e "$old_pubfile" ]]; then
        log_error "目标账号大小写 [$new_userid] 已存在公钥文件，无法迁移"
        exit 1
    fi
    if [[ -e "$new_dir" && ! -e "$old_dir" ]]; then
        log_error "目标账号大小写 [$new_userid] 已存在本地文件或目录，无法迁移"
        exit 1
    fi

    backup_ssh_config
    backup_file "$gitconfig_file"

    rename_path_case_safe "$old_keyfile" "$new_keyfile"
    rename_path_case_safe "$old_pubfile" "$new_pubfile"
    rename_path_case_safe "$old_dir" "$new_dir"

    replace_in_file "$ssh_config_file" "$old_userid" "$new_userid"
    replace_in_file "$gitconfig_file" "$old_userid" "$new_userid"

    log_ok "已将账号大小写从 [$old_userid] 迁移为 [$new_userid]"
}

remove_ssh_config_block_for_userid() {
    local userid="$1"
    local marker="$GHM_SSH_CONFIG_MARKER - $userid"
    local config_file="$SSH_DIR/config"

    [[ -f "$config_file" ]] || return 0

    local tmpfile
    tmpfile=$(mktemp "${TMPDIR:-/tmp}/ghm-ssh-config.XXXXXX")

    awk -v marker="$marker" '
        BEGIN {
            skip = 0
            seen_host = 0
        }
        {
            if (!skip && tolower($0) == tolower(marker)) {
                skip = 1
                seen_host = 0
                next
            }

            if (skip) {
                if (!seen_host) {
                    if ($0 ~ /^[[:space:]]*$/) {
                        next
                    }
                    if (tolower($1) == "host") {
                        seen_host = 1
                        next
                    }
                    if ($0 ~ /^[[:space:]]+/) {
                        next
                    }
                    skip = 0
                } else {
                    if ($0 ~ /^[[:space:]]*$/) {
                        next
                    }
                    if ($0 ~ /^[[:space:]]+/) {
                        next
                    }
                    skip = 0
                }
            }

            print
        }
    ' "$config_file" > "$tmpfile"

    write_file_preserve_symlink "$config_file" "$tmpfile"
    rm -f "$tmpfile"
}

remove_gitconfig_block_for_userid() {
    local userid="$1"
    local marker="# ghm-managed for $userid"
    local gitconfig_file="$HOME/.gitconfig"

    [[ -f "$gitconfig_file" ]] || return 0

    local tmpfile
    tmpfile=$(mktemp "${TMPDIR:-/tmp}/ghm-gitconfig.XXXXXX")

    awk -v marker="$marker" '
        BEGIN {
            skip = 0
            seen_section = 0
        }
        {
            if (!skip && tolower($0) == tolower(marker)) {
                skip = 1
                seen_section = 0
                next
            }

            if (skip) {
                if (!seen_section) {
                    if ($0 ~ /^[[:space:]]*$/) {
                        next
                    }
                    if ($0 ~ /^\[/) {
                        seen_section = 1
                        next
                    }
                    if ($0 ~ /^[[:space:]]+/) {
                        next
                    }
                    skip = 0
                } else {
                    if ($0 ~ /^[[:space:]]*$/) {
                        next
                    }
                    if ($0 ~ /^[[:space:]]+/) {
                        next
                    }
                    skip = 0
                }
            }

            print
        }
    ' "$gitconfig_file" > "$tmpfile"

    write_file_preserve_symlink "$gitconfig_file" "$tmpfile"
    rm -f "$tmpfile"
}

# ==================== 核心命令 ====================

show_help() {
    printf '%b\n' "${GREEN}ghm${NC} - GitHub 多账号管理工具"
    cat << EOF

用法:
  ghm add <UserID>          添加新 GitHub 账号（生成密钥 + 配置 SSH，保留输入大小写，查找不区分大小写）
  ghm delete <UserID>       删除账号相关的密钥和 SSH/Git 配置（账号目录仅提示，不自动删除）
  ghm list                  列出已管理的所有账号
  ghm git <git命令...>      git 包装器（按目录或 URL owner 匹配账号，否则选择；git@github.com 自动重写）
  ghm help                  显示本帮助

环境变量:
  GITHUB_BASE_DIR   默认 ~/Developer/github
  SSH_DIR           默认 ~/.ssh

目录结构示例:
  ~/Developer/github/
    ├── alice/                    # Alice 这个 GitHub 账号
    │   ├── personal/             # Alice 的个人仓库
    │   └── my-company/           # Alice 所属的组织仓库
    └── bob/                      # Bob 这个 GitHub 账号
        └── personal/

推荐克隆（可直接 git@github.com，按 owner 匹配 ~/Developer/github/<账号>/<owner>/）:
  ghm git clone git@github.com:chengzi-io/skills.git

更多信息请查看脚本顶部注释。
EOF
}

# 添加新账号
add_account() {
    local userid="${1:-}"
    if [[ -z "$userid" ]]; then
        read -rp "请输入 GitHub 账号 ID（用户名，保留原始大小写）: " userid
    fi

    if [[ -z "$userid" ]]; then
        log_error "UserID 不能为空"
        exit 1
    fi

    local input_userid="$userid"
    local existing_userid
    if existing_userid=$(find_existing_userid "$userid"); then
        if [[ "$existing_userid" != "$input_userid" ]]; then
            log_warn "已匹配到现有账号 [$existing_userid]，将迁移为新的大小写 [$input_userid]"
            rename_account_case "$existing_userid" "$input_userid"
        fi
        userid="$input_userid"
    fi

    local keyfile="$SSH_DIR/id_ed25519_$userid"
    local host_alias="$(printf %s "$userid" | tr "[:upper:]" "[:lower:]").github.com"  # ssh 的 Host 匹配大小写敏感（不会自动转小写），且 gh 靠 ssh config 别名识别 github.com，所以别名写小写并保持 URL/config 一致
    local gitconfig_file="$HOME/.gitconfig"
    local include_pattern
    include_pattern=$(gitconfig_include_pattern_for_userid "$userid")

    ensure_dirs

    # 1. 生成 SSH 密钥（无密码）
    if [[ -f "$keyfile" ]]; then
        log_warn "密钥已存在: $keyfile"
        read -rp "是否重新生成？(y/N) " ans
        if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
            log_info "跳过生成密钥"
        else
            ssh-keygen -t ed25519 -C "${userid}-$(hostname)" -f "$keyfile" -N ""
            log_ok "已重新生成密钥"
        fi
    else
        log_info "正在为账号 [$userid] 生成 SSH 密钥..."
        ssh-keygen -t ed25519 -C "${userid}-$(hostname)" -f "$keyfile" -N ""
        log_ok "密钥生成完成: $keyfile"
    fi

    # 2. 配置 ~/.ssh/config
    backup_ssh_config

    if ssh_config_has_host "$host_alias" || ssh_config_has_managed_block_for_userid "$userid"; then
        backup_ssh_config
        remove_ssh_config_block_for_userid "$userid"
        ssh_config_remove_host_blocks_by_host "$host_alias"
    fi

    if ssh_config_has_host "$host_alias"; then
        log_warn "SSH config 中已存在 Host ${host_alias}，跳过写入"
    else
        local ssh_identityfile
        ssh_identityfile=$(ssh_config_identityfile_for_userid "$userid")

        cat >> "$SSH_DIR/config" << EOF

$GHM_SSH_CONFIG_MARKER - $userid
Host ${host_alias}
    HostName ssh.github.com
    User git
    Port 443
    IdentityFile $ssh_identityfile
    IdentitiesOnly yes
EOF
        log_ok "已将 Host ${host_alias} 添加到 ~/.ssh/config"
    fi

    # 4. 创建账号目录结构
    if [[ -d "$GITHUB_BASE_DIR/$userid/personal" ]]; then
        log_info "目录已存在: $GITHUB_BASE_DIR/$userid/personal"
    else
        mkdir -p "$GITHUB_BASE_DIR/$userid/personal"
        log_ok "已创建目录: $GITHUB_BASE_DIR/$userid/personal"
    fi

    # 5. 配置 Git 提交作者身份（includeIf 方式）
    echo
    local existing_git_name=""
    local existing_git_email=""
    local has_existing_gitconfig=0
    local has_managed_gitconfig=0
    if gitconfig_has_managed_block_for_userid "$userid" || gitconfig_has_include_pattern "$include_pattern"; then
        has_existing_gitconfig=1
        if gitconfig_has_managed_block_for_userid "$userid"; then
            has_managed_gitconfig=1
            existing_git_name=$(gitconfig_get_user_field "$userid" "name" || true)
            existing_git_email=$(gitconfig_get_user_field "$userid" "email" || true)
        else
            existing_git_name=$(gitconfig_get_user_field_by_include_pattern "$include_pattern" "name" || true)
            existing_git_email=$(gitconfig_get_user_field_by_include_pattern "$include_pattern" "email" || true)
        fi
    fi

    local setup_git_prompt="是否为该账号配置 Git 提交作者信息（user.name / user.email）? [Y/n] "
    if [[ $has_existing_gitconfig -eq 1 ]]; then
        setup_git_prompt="是否确认或更新该账号的 Git 提交作者信息（user.name / user.email）? [Y/n] "
    fi
    read -rp "$setup_git_prompt" setup_git
    if [[ ! "$setup_git" =~ ^[nN]$ ]]; then
        local default_git_name="$input_userid"
        local default_git_email=""
        if [[ -n "$existing_git_name" ]]; then
            default_git_name="$existing_git_name"
        fi
        if [[ -n "$existing_git_email" ]]; then
            default_git_email="$existing_git_email"
        fi

        read -rp "请输入提交作者姓名 (user.name) [默认: $default_git_name]: " git_name
        git_name="${git_name:-$default_git_name}"

        if [[ -n "$default_git_email" ]]; then
            read -rp "请输入提交邮箱 (user.email) [默认: $default_git_email]: " git_email
            git_email="${git_email:-$default_git_email}"
        else
            read -rp "请输入提交邮箱 (user.email): " git_email
        fi

        if [[ -z "$git_email" ]]; then
            log_warn "邮箱为空，跳过 Git 配置"
        else
            if [[ $has_existing_gitconfig -eq 1 ]]; then
                local block_matches_userid=0
                if gitconfig_block_matches_userid "$userid"; then
                    block_matches_userid=1
                fi

                if [[ "$git_name" == "$existing_git_name" && "$git_email" == "$existing_git_email" && $block_matches_userid -eq 1 && $has_managed_gitconfig -eq 1 ]]; then
                    log_info "Git 提交作者信息保持不变"
                else
                    backup_file "$gitconfig_file"
                    remove_gitconfig_block_for_userid "$userid"
                    gitconfig_remove_include_blocks_by_pattern "$include_pattern"
                    cat >> "$gitconfig_file" << EOF

# ghm-managed for $userid
[includeIf "$include_pattern"]
    [user]
        name = $git_name
        email = $git_email
EOF
                    log_ok "已更新 ~/.gitconfig 中的账号配置"
                fi
            else
                if gitconfig_has_include_pattern "$include_pattern"; then
                    backup_file "$gitconfig_file"
                    gitconfig_remove_include_blocks_by_pattern "$include_pattern"
                fi
                cat >> "$gitconfig_file" << EOF

# ghm-managed for $userid
[includeIf "$include_pattern"]
    [user]
        name = $git_name
        email = $git_email
EOF
                log_ok "已添加到 ~/.gitconfig（includeIf 方式）"
            fi
        fi
    fi

    # 7. 输出添加公钥指引
    echo
    log_info "请把下面的公钥添加到 GitHub："
    echo "----------------------------------------"
    cat "${keyfile}.pub"
    echo "----------------------------------------"
    echo
    printf '%b\n' "${YELLOW}添加地址：${NC} https://github.com/settings/ssh/new"
    echo
    log_info "添加完成后，测试连接："
    echo "  ssh -T git@${host_alias}"
    echo
    log_ok "账号 [$userid] 添加完成！"
}

# 删除账号
delete_account() {
    ensure_dirs

    local userid="${1:-}"
    if [[ -z "$userid" ]]; then
        userid=$(select_managed_userid "请选择要删除的 GitHub 账号：")
    fi

    if [[ -z "$userid" ]]; then
        log_error "UserID 不能为空"
        exit 1
    fi

    local existing_userid
    if ! existing_userid=$(find_existing_userid "$userid"); then
        log_error "未找到账号: $userid"
        exit 1
    fi
    userid="$existing_userid"

    local keyfile="$SSH_DIR/id_ed25519_$userid"
    local host_alias="$(printf %s "$userid" | tr "[:upper:]" "[:lower:]").github.com"  # ssh 的 Host 匹配大小写敏感（不会自动转小写），且 gh 靠 ssh config 别名识别 github.com，所以别名写小写并保持 URL/config 一致
    local account_dir="$GITHUB_BASE_DIR/$userid"
    local gitconfig_file="$HOME/.gitconfig"
    local include_pattern
    include_pattern=$(gitconfig_include_pattern_for_userid "$userid")

    echo
    log_warn "即将清理以下内容："
    echo "  账号     : $userid"
    echo "  密钥文件 : $keyfile / ${keyfile}.pub"
    echo "  SSH Host : $host_alias"
    echo "  Git 配置 : $include_pattern"
    echo
    log_info "以下目录不会自动删除，请按需手动处理："
    echo "  账号目录 : $account_dir"
    echo

    local confirm
    read -rp "确认删除该账号的密钥和 SSH/Git 配置？[y/N] " confirm
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        log_info "已取消删除"
        return 0
    fi

    if [[ -f "$keyfile" || -f "${keyfile}.pub" ]]; then
        rm -f "$keyfile" "${keyfile}.pub"
        log_ok "已删除密钥文件"
    else
        log_warn "未找到密钥文件，跳过"
    fi

    if [[ -f "$SSH_DIR/config" ]] && { ssh_config_has_host "$host_alias" || ssh_config_has_managed_block_for_userid "$userid"; }; then
        backup_ssh_config
        remove_ssh_config_block_for_userid "$userid"
        ssh_config_remove_host_blocks_by_host "$host_alias"
        log_ok "已清理 ~/.ssh/config 中的账号配置"
    else
        log_warn "~/.ssh/config 中未找到该账号配置，跳过"
    fi

    if [[ -f "$gitconfig_file" ]] && { gitconfig_has_include_pattern "$include_pattern" || grep -Fqi "# ghm-managed for $userid" "$gitconfig_file"; }; then
        backup_file "$gitconfig_file"
        remove_gitconfig_block_for_userid "$userid"
        gitconfig_remove_include_blocks_by_pattern "$include_pattern"
        log_ok "已清理 ~/.gitconfig 中的账号配置"
    else
        log_warn "~/.gitconfig 中未找到该账号配置，跳过"
    fi

    if [[ -d "$account_dir" ]]; then
        log_info "账号目录未自动删除，请手动处理: $account_dir"
    else
        log_warn "未找到账号目录"
    fi

    log_ok "账号 [$userid] 清理完成！"
}

# 列出账号
list_accounts() {
    ensure_dirs
    printf '%b\n' "${GREEN}已管理的 GitHub 账号：${NC}"
    echo

    local found=0
    local userid
    while IFS= read -r userid; do
        [[ -n "$userid" ]] || continue
        local keyfile
        keyfile=$(find_keyfile_by_userid "$userid")
        local host_alias="$(printf %s "$userid" | tr "[:upper:]" "[:lower:]").github.com"  # ssh 的 Host 匹配大小写敏感（不会自动转小写），且 gh 靠 ssh config 别名识别 github.com，所以别名写小写并保持 URL/config 一致
        local has_host="否"
        if ssh_config_has_host "$host_alias"; then
            has_host="是"
        fi

        printf '%b\n' "  ${BLUE}●${NC} UserID: ${GREEN}$userid${NC}"
        echo "    密钥文件: $keyfile"
        echo "    SSH Host: ${host_alias}   (config 中存在: $has_host)"
        echo "    目录: $GITHUB_BASE_DIR/$userid/"
        echo
        found=1
    done < <(list_managed_userids)

    if [[ $found -eq 0 ]]; then
        log_warn "还没有添加任何账号，请使用 ghm add <UserID>"
    fi
}

# git 包装器（核心功能）
git_wrapper() {
    local userid=""
    local picked_manually=0
    if ! userid=$(resolve_git_userid_auto "$@" 2>/dev/null); then
        if userid=$(select_userid_or_plain_git "未在账号目录且未匹配到 owner 子目录，请选择: "); then
            if [[ -z "$userid" ]]; then
                exec git "$@"
            fi
            picked_manually=1
        else
            exec git "$@"
        fi
    fi

    local -a git_args=("$@")
    if [[ -n "$userid" ]]; then
        local keyfile host_alias
        if keyfile=$(find_keyfile_by_userid "$userid"); then
            host_alias="$(printf %s "$userid" | tr "[:upper:]" "[:lower:]").github.com"  # ssh 的 Host 匹配大小写敏感（不会自动转小写），且 gh 靠 ssh config 别名识别 github.com，所以别名写小写并保持 URL/config 一致
            export GIT_SSH_COMMAND="ssh -o Hostname=ssh.github.com -o Port=443 -i ${keyfile} -o IdentitiesOnly=yes"
        fi

        if [[ "${git_args[0]:-}" == "clone" ]]; then
            local -a clone_parts=()
            local -a clone_opts=()
            local remote_url="" dest_arg="" owner="" repo="" dest="" rewritten_url
            while IFS= read -r -d '' item; do
                clone_parts+=("$item")
            done < <(parse_git_clone_args "${git_args[@]}" || true)

            if (( ${#clone_parts[@]} > 0 )); then
                local last_index=$((${#clone_parts[@]} - 1))
                local remote_index=$((${#clone_parts[@]} - 2))
                remote_url="${clone_parts[$remote_index]}"
                dest_arg="${clone_parts[$last_index]}"
                if (( remote_index > 0 )); then
                    clone_opts=("${clone_parts[@]:0:$remote_index}")
                fi
            fi

            if [[ -n "$remote_url" ]]; then
                if [[ -n "$dest_arg" ]]; then
                    log_error "暂不支持显式指定 clone 目标目录，请直接使用 ghm 约定目录"
                    exit 1
                fi
                owner=$(github_owner_repo_from_url "$remote_url" | sed -n '1p')
                repo=$(github_owner_repo_from_url "$remote_url" | sed -n '2p')
                dest=$(ghm_clone_destination_for "$userid" "$owner" "$repo")
                rewritten_url="$remote_url"
                if [[ "$remote_url" =~ ^git@github\.com: ]]; then
                    rewritten_url="git@${host_alias}:${remote_url#git@github.com:}"
                elif [[ "$remote_url" =~ ^ssh://git@github\.com/ ]]; then
                    rewritten_url="ssh://git@${host_alias}/${remote_url#ssh://git@github.com/}"
                fi

                mkdir -p "$(dirname "$dest")"
                if [[ -e "$dest" ]]; then
                    log_error "目标已存在: $dest"
                    exit 1
                fi

                if [[ $picked_manually -eq 1 ]]; then
                    log_info "ghm: 使用账号 [$userid] clone → $dest" >&2
                elif [[ -n "$(detect_userid_from_pwd)" ]]; then
                    log_info "ghm: 当前目录属于账号 [$userid]，clone → $dest" >&2
                else
                    log_info "ghm: 根据 owner [$owner] 使用账号 [$userid]，clone → $dest" >&2
                fi

                if (( ${#clone_opts[@]} > 0 )); then
                    exec git clone "${clone_opts[@]}" "$rewritten_url" "$dest"
                fi
                exec git clone "$rewritten_url" "$dest"
            fi
        fi

        if [[ ${#git_args[@]} -gt 0 ]]; then
            local -a rewritten=()
            while IFS= read -r -d '' item; do
                rewritten+=("$item")
            done < <(rewrite_github_ssh_urls_in_args "$userid" "${git_args[@]}")
            git_args=("${rewritten[@]}")
        fi
    fi

    exec git "${git_args[@]}"
}

# ==================== 主入口 ====================

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        add)
            add_account "$@"
            ;;
        delete|del|remove)
            delete_account "$@"
            ;;
        list)
            list_accounts
            ;;
        git)
            git_wrapper "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "未知命令: $cmd"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
